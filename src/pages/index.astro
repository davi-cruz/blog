---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/ui';

const lang = 'pt-br';
const t = useTranslations(lang);

// Fetch all pt-br posts, excluding drafts, sorted by pubDate descending
const allPosts = await getCollection('blog', ({ slug, data }) => {
  return slug.startsWith('pt-br/') && !data.draft;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Collect popular tags
const tagCountMap: Record<string, number> = {};
for (const post of sortedPosts) {
  for (const tag of post.data.tags || []) {
    tagCountMap[tag] = (tagCountMap[tag] || 0) + 1;
  }
}
const popularTags = Object.entries(tagCountMap)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<BaseLayout
  title="Davi Cruz | Cibersegurança & Infraestrutura"
  description="Blog técnico sobre cibersegurança, ethical hacking, write-ups de máquinas do Hack The Box, Azure e administração de sistemas Linux/Windows."
  lang={lang}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <!-- Hero Section -->
    <section class="mb-14 rounded-3xl bg-gradient-to-br from-neutral-50 via-pink-50/30 to-neutral-100/50 p-8 sm:p-12 border border-neutral-200/80 dark:from-neutral-900/60 dark:via-pink-950/20 dark:to-neutral-900/40 dark:border-neutral-800">
      <div class="max-w-2xl">
        <span class="inline-flex items-center gap-1.5 rounded-full bg-pink-100 px-3 py-1 text-xs font-semibold text-pink-700 dark:bg-pink-950/60 dark:text-pink-300">
          🔒 Cybersecurity & SysAdmin
        </span>
        <h1 class="mt-4 text-3xl sm:text-5xl font-extrabold tracking-tight text-neutral-900 dark:text-white leading-tight">
          Olá, sou <span class="bg-gradient-to-r from-pink-500 to-rose-500 bg-clip-text text-transparent">Davi Cruz</span>
        </h1>
        <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">
          Bem-vindo ao meu blog técnico. Aqui compartilho write-ups detalhados do Hack The Box, pesquisas de segurança da informação, computação em nuvem (Azure Arc & Sentinel) e automações.
        </p>

        {popularTags.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center gap-2">
            <span class="text-xs font-semibold text-neutral-500 dark:text-neutral-400">Tópicos frequentes:</span>
            {popularTags.map(([tag, count]) => (
              <a
                href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}
                class="rounded-full bg-white px-2.5 py-1 text-xs font-medium text-neutral-600 shadow-sm border border-neutral-200/80 transition hover:border-pink-500 hover:text-pink-600 dark:bg-neutral-850 dark:border-neutral-700 dark:text-neutral-300 dark:hover:text-pink-400"
              >
                #{tag} <span class="text-neutral-400 text-[10px]">({count})</span>
              </a>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- Post Archive -->
    <section>
      <div class="mb-8 flex items-center justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">
          {t('blog.latestPosts')}
        </h2>
        <span class="text-sm text-neutral-500 dark:text-neutral-400">
          {sortedPosts.length} artigos
        </span>
      </div>

      {sortedPosts.length === 0 ? (
        <p class="text-neutral-500 dark:text-neutral-400">{t('blog.noPosts')}</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {sortedPosts.map((post) => (
            <PostCard post={post} lang={lang} />
          ))}
        </div>
      )}
    </section>
  </div>
</BaseLayout>

