---
import type { CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import type { Lang } from '../../i18n/ui';
import { getPostRoutesForLang, type FallbackInfo } from '../../utils/postFallback';

export async function getStaticPaths() {
  const paths = [];

  for (const l of ['en', 'es'] as Lang[]) {
    const routes = await getPostRoutesForLang(l);
    for (const r of routes) {
      paths.push({
        params: { lang: l, slug: r.slug },
        props: {
          post: r.post,
          lang: l,
          fallbackInfo: r.fallbackInfo,
          prevPost: r.prevPost,
          nextPost: r.nextPost,
        },
      });
    }
  }

  return paths;
}

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
  fallbackInfo: FallbackInfo | null;
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { post, lang, fallbackInfo, prevPost, nextPost } = Astro.props;
const { headings } = await post.render();
---

<PostLayout
  post={post}
  lang={lang}
  headings={headings}
  prevPost={prevPost}
  nextPost={nextPost}
  fallbackInfo={fallbackInfo}
/>
