---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TimelinePostItem from '../../../components/TimelinePostItem.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  const paths = [];

  for (const l of ['en', 'es'] as Lang[]) {
    const langPosts = allPosts.filter((p) => p.slug.startsWith(`${l}/`));
    const tagMap: Record<string, { rawTag: string; posts: CollectionEntry<'blog'>[] }> = {};

    for (const post of langPosts) {
      for (const tag of post.data.tags || []) {
        const lower = tag.toLowerCase();
        if (!tagMap[lower]) {
          tagMap[lower] = { rawTag: tag, posts: [] };
        }
        tagMap[lower].posts.push(post);
      }
    }

    for (const [tagKey, data] of Object.entries(tagMap)) {
      paths.push({
        params: { lang: l, tag: tagKey },
        props: {
          lang: l,
          rawTag: data.rawTag,
          posts: data.posts.sort(
            (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
          ),
        },
      });
    }
  }

  return paths;
}

interface Props {
  lang: Lang;
  rawTag: string;
  posts: CollectionEntry<'blog'>[];
}

const { lang, rawTag, posts } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout
  title={`#${rawTag} | Davi Cruz`}
  description={`Posts tagged with #${rawTag}.`}
  lang={lang}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="border-b border-gray-200 pb-8 dark:border-gray-700">
      <a
        href={`/${lang}/tags/`}
        class="inline-flex items-center gap-1 text-sm font-medium text-gray-500 hover:text-primary-500 transition-colors mb-4"
      >
        &larr; {t('nav.tags')}
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100">
        {t('blog.postsTaggedWith')} <span class="text-primary-500 uppercase">{rawTag}</span>
      </h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        {posts.length} {lang === 'es' ? (posts.length === 1 ? 'artículo encontrado' : 'artículos encontrados') : (posts.length === 1 ? 'post found' : 'posts found')}.
      </p>
    </div>

    <ul class="divide-y divide-gray-200 dark:divide-gray-700">
      {posts.map((post) => (
        <TimelinePostItem post={post} lang={lang} />
      ))}
    </ul>
  </div>
</BaseLayout>
