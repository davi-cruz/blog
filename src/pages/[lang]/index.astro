---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedPostCard from '../../components/FeaturedPostCard.astro';
import TimelinePostItem from '../../components/TimelinePostItem.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

// Fetch all posts for this language, excluding drafts
const allPosts = await getCollection('blog', ({ slug, data }) => {
  return slug.startsWith(`${lang}/`) && !data.draft;
});

const sortedPosts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = sortedPosts[0];
const archivePosts = sortedPosts.slice(1);

// Collect popular tags
const tagCountMap: Record<string, number> = {};
for (const post of sortedPosts) {
  for (const tag of post.data.tags || []) {
    tagCountMap[tag] = (tagCountMap[tag] || 0) + 1;
  }
}
const popularTags = Object.entries(tagCountMap)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);

const titles: Record<Lang, string> = {
  'pt-br': 'Davi Cruz | Cibersegurança & Infraestrutura',
  en: 'Davi Cruz | Cybersecurity & Infrastructure',
  es: 'Davi Cruz | Ciberseguridad e Infraestructura',
};

const descriptions: Record<Lang, string> = {
  'pt-br': 'Blog técnico sobre cibersegurança e infraestrutura.',
  en: 'Technical blog focusing on cybersecurity, Hack The Box write-ups, Azure cloud security, and Linux administration.',
  es: 'Blog técnico enfocado en ciberseguridad, write-ups de Hack The Box, seguridad en la nube de Azure y administración de Linux.',
};

const heroIntros: Record<Lang, string> = {
  'pt-br': 'Bem-vindo ao meu blog técnico.',
  en: "Welcome to my technical blog. Here I share detailed Hack The Box walkthroughs, security research, cloud computing guides (Azure Arc & Sentinel), and automation scripts.",
  es: "Bienvenido a mi blog técnico. Aquí comparto write-ups detallados de Hack The Box, investigaciones de seguridad, computación en la nube (Azure Arc y Sentinel) y scripts de automatización.",
};

const greetings: Record<Lang, string> = {
  'pt-br': 'Olá, sou',
  en: "Hi, I'm",
  es: 'Hola, soy',
};

const tagSectionLabel: Record<Lang, string> = {
  'pt-br': 'Tópicos:',
  en: 'Topics:',
  es: 'Temas:',
};
---

<BaseLayout
  title={titles[lang] || titles.en}
  description={descriptions[lang] || descriptions.en}
  lang={lang}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="divide-y divide-gray-200 dark:divide-gray-700">
      <!-- Header Section -->
      <header class="space-y-2 pb-8 pt-6 md:space-y-5">
        <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:text-5xl md:leading-14">
          {greetings[lang]} <span class="text-primary-500">Davi Cruz</span>
        </h1>
        <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">
          {heroIntros[lang]}
        </p>

        {popularTags.length > 0 && (
          <div class="pt-2 flex flex-wrap items-center">
            <span class="mr-3 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">{tagSectionLabel[lang]}</span>
            {popularTags.map(([tag, count]) => (
              <a
                href={`/${lang}/tags/${encodeURIComponent(tag.toLowerCase())}`}
                class="mr-3 text-sm font-medium uppercase text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
              >
                {tag} <span class="text-xs text-gray-500 dark:text-gray-400">({count})</span>
              </a>
            ))}
          </div>
        )}
      </header>

      <!-- Posts Section -->
      <div class="py-8 space-y-12">
        <!-- Highlighted Latest Post (Option C) -->
        {featuredPost && (
          <section>
            <FeaturedPostCard post={featuredPost} lang={lang} />
          </section>
        )}

        <!-- Classic Timeline Archive -->
        <section>
          <div class="border-b border-gray-200 pb-4 dark:border-gray-700 flex items-center justify-between">
            <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
              {t('blog.allPosts')}
            </h2>
            <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
              {sortedPosts.length} {lang === 'es' ? 'artículos' : 'posts'}
            </span>
          </div>

          {archivePosts.length === 0 && !featuredPost ? (
            <p class="py-10 text-gray-500 dark:text-gray-400">{t('blog.noPosts')}</p>
          ) : (
            <ul class="divide-y divide-gray-200 dark:divide-gray-700">
              {archivePosts.map((post) => (
                <TimelinePostItem post={post} lang={lang} />
              ))}
            </ul>
          )}
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
