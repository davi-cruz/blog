---
import type { CollectionEntry } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { getPostRoutesForLang, type FallbackInfo } from '../utils/postFallback';

export async function getStaticPaths() {
  const routes = await getPostRoutesForLang('pt-br');
  return routes.map((r) => ({
    params: { slug: r.slug },
    props: {
      post: r.post,
      fallbackInfo: r.fallbackInfo,
      prevPost: r.prevPost,
      nextPost: r.nextPost,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  fallbackInfo: FallbackInfo | null;
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
}

const { post, fallbackInfo, prevPost, nextPost } = Astro.props;
const { headings } = await post.render();
---

<PostLayout
  post={post}
  lang="pt-br"
  headings={headings}
  prevPost={prevPost}
  nextPost={nextPost}
  fallbackInfo={fallbackInfo}
/>
