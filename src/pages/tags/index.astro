---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/ui';

const lang = 'pt-br';
const t = useTranslations(lang);

const posts = await getCollection('blog', ({ slug, data }) => {
  return slug.startsWith('pt-br/') && !data.draft;
});

const tagMap: Record<string, number> = {};
for (const post of posts) {
  for (const tag of post.data.tags || []) {
    tagMap[tag] = (tagMap[tag] || 0) + 1;
  }
}

const tags = Object.entries(tagMap).sort((a, b) => b[1] - a[1]);
---

<BaseLayout
  title={`Tags | Davi Cruz`}
  description="Navegue por todos os tópicos e categorias de artigos sobre cibersegurança e infraestrutura."
  lang={lang}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col items-start justify-start divide-y divide-gray-200 dark:divide-gray-700 md:mt-24 md:flex-row md:items-center md:justify-center md:space-x-6 md:divide-y-0">
      <div class="space-x-2 pt-6 pb-8 md:space-y-5">
        <h1 class="text-3xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl sm:leading-10 md:border-r-2 md:border-gray-200 md:dark:border-gray-700 md:px-6 md:text-6xl md:leading-14">
          {t('blog.tags')}
        </h1>
      </div>
      <div class="flex max-w-lg flex-wrap pt-6 md:pt-0">
        {tags.length === 0 && <p class="text-gray-500 dark:text-gray-400">Nenhuma tag encontrada.</p>}
        {tags.map(([tag, count]) => (
          <div class="mt-2 mb-2 mr-5">
            <a
              href={`/tags/${encodeURIComponent(tag.toLowerCase())}`}
              class="mr-1 text-sm font-medium uppercase text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
            >
              {tag}
            </a>
            <span class="text-sm font-semibold uppercase text-gray-600 dark:text-gray-300">
              ({count})
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

