---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TimelinePostItem from '../../components/TimelinePostItem.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { useTranslations } from '../../i18n/ui';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ slug, data }) => {
    return slug.startsWith('pt-br/') && !data.draft;
  });

  const tagMap: Record<string, { rawTag: string; posts: CollectionEntry<'blog'>[] }> = {};

  for (const post of posts) {
    for (const tag of post.data.tags || []) {
      const lower = tag.toLowerCase();
      if (!tagMap[lower]) {
        tagMap[lower] = { rawTag: tag, posts: [] };
      }
      tagMap[lower].posts.push(post);
    }
  }

  return Object.entries(tagMap).map(([tagKey, data]) => {
    return {
      params: { tag: tagKey },
      props: {
        rawTag: data.rawTag,
        posts: data.posts.sort(
          (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
        ),
      },
    };
  });
}

interface Props {
  rawTag: string;
  posts: CollectionEntry<'blog'>[];
}

const { rawTag, posts } = Astro.props;
const lang = 'pt-br';
const t = useTranslations(lang);
---

<BaseLayout
  title={`Tag #${rawTag} | Davi Cruz`}
  description={`Artigos e tutoriais com a tag #${rawTag}.`}
  lang={lang}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="border-b border-gray-200 pb-8 dark:border-gray-700">
      <a
        href="/tags/"
        class="inline-flex items-center gap-1 text-sm font-medium text-gray-500 hover:text-primary-500 transition-colors mb-4"
      >
        &larr; Todas as tags
      </a>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100">
        {t('blog.postsTaggedWith')} <span class="text-primary-500 uppercase">{rawTag}</span>
      </h1>
      <p class="mt-2 text-gray-600 dark:text-gray-400">
        {posts.length} {posts.length === 1 ? 'artigo encontrado' : 'artigos encontrados'}.
      </p>
    </div>

    <ul class="divide-y divide-gray-200 dark:divide-gray-700">
      {posts.map((post) => (
        <TimelinePostItem post={post} lang={lang} />
      ))}
    </ul>
  </div>
</BaseLayout>
