---
interface Props {
  kind?: 'info' | 'warning' | 'error' | 'success' | 'tip' | 'notice';
  title?: string;
}

const { kind = 'info', title } = Astro.props;

const styles = {
  info: 'bg-blue-50 border-blue-500 text-blue-900 dark:bg-blue-950/40 dark:border-blue-500 dark:text-blue-200',
  warning: 'bg-amber-50 border-amber-500 text-amber-900 dark:bg-amber-950/40 dark:border-amber-500 dark:text-amber-200',
  error: 'bg-red-50 border-red-500 text-red-900 dark:bg-red-950/40 dark:border-red-500 dark:text-red-200',
  success: 'bg-emerald-50 border-emerald-500 text-emerald-900 dark:bg-emerald-950/40 dark:border-emerald-500 dark:text-emerald-200',
  tip: 'bg-teal-50 border-teal-500 text-teal-900 dark:bg-teal-950/40 dark:border-teal-500 dark:text-teal-200',
  notice: 'bg-neutral-50 border-neutral-500 text-neutral-900 dark:bg-neutral-900/60 dark:border-neutral-500 dark:text-neutral-200',
};

const currentStyle = styles[kind] || styles.info;
---

<div class={`my-5 rounded-r-lg border-l-4 p-4 shadow-sm not-prose ${currentStyle}`} role="alert">
  <div class="flex items-start">
    <div class="mr-3 flex-shrink-0 pt-0.5">
      {kind === 'info' && (
        <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
        </svg>
      )}
      {kind === 'warning' && (
        <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
      )}
      {kind === 'error' && (
        <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
        </svg>
      )}
      {(kind === 'success' || kind === 'tip') && (
        <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
      )}
      {kind === 'notice' && (
        <svg class="h-5 w-5 fill-current" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
        </svg>
      )}
    </div>
    <div class="flex-1">
      {title && <p class="font-bold mb-1 text-sm tracking-wide uppercase">{title}</p>}
      <div class="text-sm leading-relaxed">
        <slot />
      </div>
    </div>
  </div>
</div>

