---
import Icon from './Icon.astro';
---

<div
  id="image-lightbox"
  class="fixed inset-0 z-50 hidden flex-col items-center justify-center bg-gray-950/90 p-4 backdrop-blur-md transition-opacity duration-200 opacity-0 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-label="Image preview"
>
  <!-- Top Controls: Counter & Close Button -->
  <div class="absolute top-4 left-4 right-4 z-10 flex items-center justify-between pointer-events-none sm:top-6 sm:left-6 sm:right-6">
    <span
      id="lightbox-counter"
      class="pointer-events-auto rounded-full bg-gray-900/80 px-3 py-1 text-xs font-medium text-gray-200 ring-1 ring-white/15 backdrop-blur-sm"
    >
      1 / 1
    </span>

    <button
      type="button"
      id="lightbox-close-btn"
      class="pointer-events-auto inline-flex items-center justify-center rounded-full bg-gray-900/80 p-2.5 text-gray-200 ring-1 ring-white/15 backdrop-blur-sm transition hover:bg-gray-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-primary-500"
      aria-label="Close image preview"
    >
      <Icon name="close" size="md" />
    </button>
  </div>

  <!-- Previous Image Button -->
  <button
    type="button"
    id="lightbox-prev-btn"
    class="absolute left-3 top-1/2 z-10 -translate-y-1/2 rounded-full bg-gray-900/80 p-2.5 text-gray-200 ring-1 ring-white/15 backdrop-blur-sm transition hover:bg-gray-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 sm:left-6"
    aria-label="Previous image"
  >
    <Icon name="chevron-left" size="lg" />
  </button>

  <!-- Next Image Button -->
  <button
    type="button"
    id="lightbox-next-btn"
    class="absolute right-3 top-1/2 z-10 -translate-y-1/2 rounded-full bg-gray-900/80 p-2.5 text-gray-200 ring-1 ring-white/15 backdrop-blur-sm transition hover:bg-gray-800 hover:text-white focus:outline-none focus:ring-2 focus:ring-primary-500 sm:right-6"
    aria-label="Next image"
  >
    <Icon name="chevron-right" size="lg" />
  </button>

  <!-- Image & Caption Container -->
  <figure class="relative flex max-h-[85vh] max-w-[92vw] flex-col items-center justify-center">
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[78vh] max-w-[90vw] rounded-xl object-contain shadow-2xl ring-1 ring-white/10 transition-transform duration-200 scale-95 select-none"
    />
    <figcaption
      id="lightbox-caption"
      class="mt-3 max-w-2xl text-center text-sm font-medium text-gray-200 bg-gray-900/75 px-4 py-1.5 rounded-lg ring-1 ring-white/10 backdrop-blur-sm hidden"
    ></figcaption>
  </figure>
</div>

<script>
  function setupImageLightbox() {
    const lightbox = document.getElementById('image-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');

    if (!lightbox || !lightboxImg || !lightboxCaption || !lightboxCounter || !closeBtn || !prevBtn || !nextBtn) {
      return;
    }

    // Collect all zoomable images in the blog post (heroImage + article prose images)
    const nodeList = document.querySelectorAll<HTMLImageElement>(
      'img[data-zoomable], article.prose img:not([data-no-zoom])'
    );
    const images = Array.from(nodeList);
    if (images.length === 0) return;

    let currentIndex = 0;
    let isOpen = false;

    function updateSlide(index: number) {
      if (images.length === 0 || !lightboxImg || !lightboxCaption || !lightboxCounter || !prevBtn || !nextBtn) return;
      currentIndex = (index + images.length) % images.length;
      const target = images[currentIndex];

      lightboxImg.src = target.currentSrc || target.src;
      lightboxImg.alt = target.alt || '';

      const captionText = target.alt?.trim();
      if (captionText) {
        lightboxCaption.textContent = captionText;
        lightboxCaption.classList.remove('hidden');
      } else {
        lightboxCaption.textContent = '';
        lightboxCaption.classList.add('hidden');
      }

      if (images.length > 1) {
        lightboxCounter.textContent = `${currentIndex + 1} / ${images.length}`;
        lightboxCounter.classList.remove('hidden');
        prevBtn.classList.remove('hidden');
        nextBtn.classList.remove('hidden');
      } else {
        lightboxCounter.classList.add('hidden');
        prevBtn.classList.add('hidden');
        nextBtn.classList.add('hidden');
      }
    }

    function openLightbox(index: number) {
      if (!lightbox || !lightboxImg) return;
      updateSlide(index);
      isOpen = true;
      document.body.style.overflow = 'hidden';
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      requestAnimationFrame(() => {
        lightbox.classList.remove('opacity-0');
        lightbox.classList.add('opacity-100');
        lightboxImg.classList.remove('scale-95');
        lightboxImg.classList.add('scale-100');
      });
      closeBtn?.focus();
    }

    function closeLightbox() {
      if (!lightbox || !lightboxImg || !isOpen) return;
      isOpen = false;
      lightbox.classList.remove('opacity-100');
      lightbox.classList.add('opacity-0');
      lightboxImg.classList.remove('scale-100');
      lightboxImg.classList.add('scale-95');
      document.body.style.overflow = '';
      setTimeout(() => {
        if (!isOpen) {
          lightbox.classList.remove('flex');
          lightbox.classList.add('hidden');
        }
      }, 200);
    }

    images.forEach((img, idx) => {
      if (img.dataset.lightboxBound === 'true') return;
      img.dataset.lightboxBound = 'true';
      img.classList.add('cursor-zoom-in', 'transition-transform', 'duration-200', 'hover:scale-[1.01]');
      if (!img.hasAttribute('tabindex')) {
        img.setAttribute('tabindex', '0');
      }
      img.setAttribute('role', 'button');

      img.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openLightbox(idx);
      });

      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(idx);
        }
      });
    });

    closeBtn.onclick = () => closeLightbox();
    prevBtn.onclick = (e) => {
      e.stopPropagation();
      updateSlide(currentIndex - 1);
    };
    nextBtn.onclick = (e) => {
      e.stopPropagation();
      updateSlide(currentIndex + 1);
    };

    lightbox.onclick = (e) => {
      if (e.target === lightbox || (e.target as HTMLElement).tagName === 'FIGURE') {
        closeLightbox();
      }
    };

    // Clean up any previous keydown handler before registering
    const prevHandler = (window as any).__daviLightboxKeyHandler;
    if (prevHandler) {
      window.removeEventListener('keydown', prevHandler);
    }

    const keyHandler = (e: KeyboardEvent) => {
      if (!isOpen) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        closeLightbox();
      } else if (e.key === 'ArrowLeft' && images.length > 1) {
        e.preventDefault();
        updateSlide(currentIndex - 1);
      } else if (e.key === 'ArrowRight' && images.length > 1) {
        e.preventDefault();
        updateSlide(currentIndex + 1);
      }
    };

    (window as any).__daviLightboxKeyHandler = keyHandler;
    window.addEventListener('keydown', keyHandler);
  }

  setupImageLightbox();
  document.addEventListener('astro:after-swap', setupImageLightbox);
</script>
