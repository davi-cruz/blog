---
import { useTranslations, defaultLang, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  currentLang?: Lang;
  lang?: Lang;
}

const { currentLang, lang } = Astro.props;
const activeLang = lang || currentLang || defaultLang;
const t = useTranslations(activeLang);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-gray-200/80 bg-gray-50/50 py-10 dark:border-gray-800/80 dark:bg-gray-950/50">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-4 sm:flex-row sm:px-6 lg:px-8">
    <!-- Copyright & Privacy -->
    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 sm:gap-3 text-xs text-gray-500 dark:text-gray-400 text-center sm:text-left">
      <p>© {year} Davi Cruz. {t('footer.rights')}</p>
      <span class="hidden sm:inline text-gray-400 dark:text-gray-600">•</span>
      <a
        href={activeLang === 'pt-br' ? '/privacidade' : activeLang === 'es' ? '/es/privacidad' : '/en/privacy'}
        class="hover:text-primary-500 dark:hover:text-primary-400 underline underline-offset-2 transition-colors"
      >
        {activeLang === 'pt-br' ? 'Política de Privacidade' : activeLang === 'es' ? 'Política de Privacidad' : 'Privacy Policy'}
      </a>
      <span class="hidden sm:inline text-gray-400 dark:text-gray-600">•</span>
      <button
        type="button"
        id="open-cookie-settings-btn"
        class="hover:text-primary-500 dark:hover:text-primary-400 underline underline-offset-2 transition-colors cursor-pointer"
      >
        {activeLang === 'pt-br' ? 'Preferências de Cookies' : activeLang === 'es' ? 'Preferencias de Cookies' : 'Cookie Settings'}
      </button>
    </div>

    <!-- Socials & RSS -->
    <div class="flex items-center space-x-5 text-gray-500 dark:text-gray-400">
      <!-- GitHub -->
      <a
        href="https://github.com/davi-cruz"
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-gray-900 dark:hover:text-white"
        aria-label="GitHub Profile"
      >
        <Icon name="github" size="sm" class="fill-current" />
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/davicruz"
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-[#0A66C2]"
        aria-label="LinkedIn Profile"
      >
        <Icon name="linkedin" size="sm" class="fill-current" />
      </a>

      <!-- Twitter / X -->
      <a
        href="https://twitter.com/zerahzurc"
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-gray-900 dark:hover:text-white"
        aria-label="Twitter Profile"
      >
        <Icon name="twitter" size="sm" class="fill-current" />
      </a>

      <!-- RSS Feed -->
      <a
        href="/rss.xml"
        class="transition hover:text-amber-500"
        aria-label="RSS Feed"
      >
        <Icon name="rss" size="sm" />
      </a>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById('open-cookie-settings-btn')?.addEventListener('click', function () {
    window.dispatchEvent(new CustomEvent('open-cookie-banner'));
  });
</script>
