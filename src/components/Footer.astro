---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  currentLang: Lang;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-neutral-200/80 bg-neutral-50/50 py-10 dark:border-neutral-800/80 dark:bg-neutral-950/50">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-4 sm:flex-row sm:px-6 lg:px-8">
    <!-- Copyright -->
    <div class="text-xs text-neutral-500 dark:text-neutral-400 text-center sm:text-left">
      <p>© {year} Davi Cruz. {t('footer.rights')}</p>
    </div>

    <!-- Socials & RSS -->
    <div class="flex items-center space-x-5 text-neutral-500 dark:text-neutral-400">
      <!-- GitHub -->
      <a
        href="https://github.com/davi-cruz"
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-neutral-900 dark:hover:text-white"
        aria-label="GitHub Profile"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
      </a>

      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/davicruz"
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-[#0A66C2]"
        aria-label="LinkedIn Profile"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c-.97 0-1.75-.79-1.75-1.76s.78-1.75 1.75-1.75c.97 0 1.76.78 1.76 1.75 0 .97-.79 1.76-1.76 1.76m1.39 9.74v-8.37H5.07v8.37h2.78z" />
        </svg>
      </a>

      <!-- X / Twitter -->
      <a
        href="https://twitter.com/zerahzurc"
        target="_blank"
        rel="noopener noreferrer"
        class="transition hover:text-neutral-900 dark:hover:text-white"
        aria-label="X Profile"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
        </svg>
      </a>

      <!-- RSS -->
      <a
        href="/rss.xml"
        class="flex items-center gap-1 text-xs font-medium text-primary-500 hover:text-primary-600 transition"
        aria-label="RSS Feed"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z" />
        </svg>
        <span>{t('footer.rss')}</span>
      </a>
    </div>
  </div>
</footer>

