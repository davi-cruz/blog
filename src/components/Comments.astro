---
import { useTranslations, type Lang } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  translationId: string;
  lang?: Lang;
}

const { translationId, lang = 'pt-br' } = Astro.props;
const t = useTranslations(lang);
---

<section class="mt-14 pt-8 border-t border-gray-200 dark:border-gray-800" id="comments">
  <div class="mb-6 flex items-center gap-2">
    <Icon name="comments" size="md" class="text-primary-500" />
    <h2 class="text-xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
      {t('comments.title')}
    </h2>
  </div>

  <div id="utterances-container" class="min-h-[220px]" data-translation-id={translationId}></div>
</section>

<script>
  function initUtterances() {
    const container = document.getElementById('utterances-container');
    if (!container) return;

    // Clear existing iframe if re-initializing
    container.innerHTML = '';

    const translationId = container.dataset.translationId || '';
    const isDark = document.documentElement.classList.contains('dark');
    const theme = isDark ? 'github-dark' : 'github-light';

    const script = document.createElement('script');
    script.src = 'https://utteranc.es/client.js';
    script.setAttribute('repo', 'davi-cruz/blog-comments');
    script.setAttribute('issue-term', translationId);
    script.setAttribute('label', 'comments');
    script.setAttribute('theme', theme);
    script.setAttribute('crossorigin', 'anonymous');
    script.async = true;

    container.appendChild(script);
  }

  // Sync theme changes in real-time
  function setupThemeObserver() {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains('dark');
      const theme = isDark ? 'github-dark' : 'github-light';
      const iframe = document.querySelector<HTMLIFrameElement>('.utterances-frame');
      if (iframe && iframe.contentWindow) {
        iframe.contentWindow.postMessage(
          { type: 'set-theme', theme },
          'https://utteranc.es'
        );
      }
    });

    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }

  initUtterances();
  setupThemeObserver();
  document.addEventListener('astro:after-swap', () => {
    initUtterances();
  });
</script>

