---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);

const slugPart = post.slug.split('/').slice(1).join('/');
const postUrl = lang === 'pt-br' ? `/${slugPart}` : `/${lang}/${slugPart}`;

// Format date according to locale
const formattedDate = new Intl.DateTimeFormat(
  lang === 'pt-br' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US',
  {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }
).format(post.data.pubDate);

const readingMinutes = getReadingTime(post.body);
---

<article class="group relative flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-6 transition-all duration-200 hover:-translate-y-1 hover:border-primary-500 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/50 dark:hover:border-primary-500">
  <div>
    {post.data.heroImage && (
      <div class="mb-4 overflow-hidden rounded-xl border border-gray-100 dark:border-gray-800 aspect-video w-full">
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      </div>
    )}

    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
      <time datetime={post.data.pubDate.toISOString()}>
        {formattedDate}
      </time>
      <span>•</span>
      <span>{readingMinutes} {t('blog.readTime')}</span>
    </div>

    <h2 class="mt-3 text-xl font-bold tracking-tight text-gray-900 group-hover:text-primary-500 dark:text-white dark:group-hover:text-primary-400 transition-colors">
      <a href={postUrl}>
        <span class="absolute inset-0 z-0"></span>
        {post.data.title}
      </a>
    </h2>

    <p class="mt-2.5 text-sm text-gray-600 line-clamp-3 dark:text-gray-300 leading-relaxed">
      {post.data.description}
    </p>
  </div>

  {post.data.tags && post.data.tags.length > 0 && (
    <div class="relative z-10 mt-5 flex flex-wrap pt-4 border-t border-gray-100 dark:border-gray-800/80">
      {post.data.tags.map((tag) => {
        const tagUrl = lang === 'pt-br' ? `/tags/${encodeURIComponent(tag.toLowerCase())}` : `/${lang}/tags/${encodeURIComponent(tag.toLowerCase())}`;
        return (
          <a
            href={tagUrl}
            class="mr-3 text-xs font-semibold uppercase tracking-wider text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
          >
            {tag}
          </a>
        );
      })}
    </div>
  )}
</article>

