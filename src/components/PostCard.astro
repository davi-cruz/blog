---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);

const slugPart = post.slug.split('/').slice(1).join('/');
const postUrl = lang === 'pt-br' ? `/${slugPart}` : `/${lang}/${slugPart}`;

// Format date according to locale
const formattedDate = new Intl.DateTimeFormat(
  lang === 'pt-br' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US',
  {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }
).format(post.data.pubDate);

const readingMinutes = getReadingTime(post.body);
---

<article class="group relative flex flex-col justify-between rounded-2xl border border-neutral-200/80 bg-white p-6 transition-all duration-200 hover:-translate-y-1 hover:border-primary-500/50 hover:shadow-lg dark:border-neutral-800 dark:bg-neutral-900/50 dark:hover:border-primary-500/50 dark:hover:shadow-neutral-950">
  <div>
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-neutral-500 dark:text-neutral-400">
      <time datetime={post.data.pubDate.toISOString()}>
        {formattedDate}
      </time>
      <span>•</span>
      <span>{readingMinutes} {t('blog.readTime')}</span>
    </div>

    <h2 class="mt-3 text-xl font-bold tracking-tight text-neutral-900 group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400 transition-colors">
      <a href={postUrl}>
        <span class="absolute inset-0 z-0"></span>
        {post.data.title}
      </a>
    </h2>

    <p class="mt-2.5 text-sm text-neutral-600 line-clamp-3 dark:text-neutral-300 leading-relaxed">
      {post.data.description}
    </p>
  </div>

  {post.data.tags && post.data.tags.length > 0 && (
    <div class="relative z-10 mt-5 flex flex-wrap gap-1.5 pt-4 border-t border-neutral-100 dark:border-neutral-800/80">
      {post.data.tags.map((tag) => {
        const tagUrl = lang === 'pt-br' ? `/tags/${encodeURIComponent(tag.toLowerCase())}` : `/${lang}/tags/${encodeURIComponent(tag.toLowerCase())}`;
        return (
          <a
            href={tagUrl}
            class="rounded-md bg-neutral-100 px-2 py-0.5 text-xs font-medium text-neutral-600 transition hover:bg-primary-50 hover:text-primary-600 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-primary-950/60 dark:hover:text-primary-400"
          >
            #{tag}
          </a>
        );
      })}
    </div>
  )}
</article>

