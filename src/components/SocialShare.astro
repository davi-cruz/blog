---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  url: string;
  lang: Lang;
}

const { title, url, lang } = Astro.props;
const t = useTranslations(lang);

const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const whatsAppUrl = `https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`;
const telegramUrl = `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}`;
---

<div class="my-8 rounded-xl border border-gray-200 bg-gray-50/70 p-4 dark:border-gray-800 dark:bg-gray-900/40">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <span class="text-sm font-semibold text-gray-700 dark:text-gray-300">
      {t('share.title')}
    </span>

    <div class="flex flex-wrap items-center gap-2" id="share-buttons" data-title={title} data-url={url}>
      <!-- Native OS Share Button (Hidden on browsers without navigator.share) -->
      <button
        type="button"
        id="native-share-btn"
        class="hidden items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 transition hover:bg-gray-100 hover:text-gray-900 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white"
        aria-label={t('share.native')}
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
        </svg>
        <span>{t('share.native')}</span>
      </button>

      <!-- LinkedIn -->
      <a
        href={linkedInUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 transition hover:bg-[#0A66C2] hover:text-white hover:border-[#0A66C2] dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-[#0A66C2] dark:hover:text-white"
        aria-label="LinkedIn"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c-.97 0-1.75-.79-1.75-1.76s.78-1.75 1.75-1.75c.97 0 1.76.78 1.76 1.75 0 .97-.79 1.76-1.76 1.76m1.39 9.74v-8.37H5.07v8.37h2.78z" />
        </svg>
        <span>LinkedIn</span>
      </a>

      <!-- WhatsApp -->
      <a
        href={whatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 transition hover:bg-[#25D366] hover:text-white hover:border-[#25D366] dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-[#25D366] dark:hover:text-white"
        aria-label="WhatsApp"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.39-4.19-1.15l-.3-.17-3.12.82.83-3.04-.2-.31a8.214 8.214 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24M8.53 7.33c-.16 0-.35.06-.53.25-.19.19-.71.69-.71 1.69 0 1 .73 1.96.83 2.1.1.13 1.41 2.21 3.49 3.07.49.21.88.33 1.18.43.5.16.95.14 1.31.08.4-.06 1.22-.5 1.39-.98.17-.49.17-.91.12-.99-.05-.08-.19-.13-.4-.23s-1.22-.6-1.41-.67c-.19-.07-.33-.1-.47.1-.14.21-.55.69-.67.83-.12.14-.24.16-.45.05-.21-.1-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.24-.01-.37.09-.47.09-.09.21-.24.31-.36.1-.12.14-.2.21-.34.07-.14.03-.26-.02-.36-.05-.1-.47-1.13-.64-1.55-.17-.41-.34-.35-.47-.36h-.4z" />
        </svg>
        <span>WhatsApp</span>
      </a>

      <!-- Telegram -->
      <a
        href={telegramUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 transition hover:bg-[#229ED9] hover:text-white hover:border-[#229ED9] dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-[#229ED9] dark:hover:text-white"
        aria-label="Telegram"
      >
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.75-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z" />
        </svg>
        <span>Telegram</span>
      </a>

      <!-- Copy link -->
      <button
        type="button"
        id="copy-link-btn"
        class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 transition hover:bg-gray-100 hover:text-gray-900 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white"
        aria-label={t('share.copyLink')}
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
        </svg>
        <span id="copy-btn-text">{t('share.copyLink')}</span>
      </button>
    </div>
  </div>
</div>

<script>
  function setupShare() {
    const container = document.getElementById('share-buttons');
    if (!container) return;

    const title = container.getAttribute('data-title') || '';
    const url = container.getAttribute('data-url') || window.location.href;

    const nativeBtn = document.getElementById('native-share-btn');
    if (nativeBtn && navigator.share) {
      nativeBtn.classList.remove('hidden');
      nativeBtn.classList.add('inline-flex');
      nativeBtn.addEventListener('click', async () => {
        try {
          await navigator.share({ title, url });
        } catch {
          // User dismissed share
        }
      });
    }

    const copyBtn = document.getElementById('copy-link-btn');
    const copyText = document.getElementById('copy-btn-text');
    if (copyBtn && copyText) {
      const originalText = copyText.innerText;
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          copyText.innerText = '✓ Copied!';
          setTimeout(() => {
            copyText.innerText = originalText;
          }, 2000);
        } catch {
          // clipboard error fallback
        }
      });
    }
  }

  setupShare();
  document.addEventListener('astro:after-swap', setupShare);
</script>

