const muiComponentName = MUI_ICON_MAP[name];

// Dynamically resolve from installed @mui/icons-material package when node_modules is available
function resolveMuiSvgNode(iconKey: IconName, muiName: string): SvgNode {
  try {
    const require = createRequire(import.meta.url);
    const modulePath = require.resolve(`@mui/icons-material/${muiName}.js`);
    const source = fs.readFileSync(modulePath, 'utf-8');
    const extractedPaths = Array.from(source.matchAll(/\bd:\s*["']([^"']+)["']/g), (m) => m[1]);
    const extractedCircles = Array.from(
      source.matchAll(/cx:\s*["']([^"']+)["'],\s*cy:\s*["']([^"']+)["'],\s*r:\s*["']([^"']+)["']/g),
      (m) => ({ cx: m[1], cy: m[2], r: m[3] })
    );
    if (extractedPaths.length > 0) {
      return {
        paths: extractedPaths,
        circles: extractedCircles.length > 0 ? extractedCircles : undefined,
      };
    }
  } catch {
    // Fallback to embedded @mui/icons-material definitions when building before `npm install`
  }
  return MUI_SVG_DATA[iconKey];
}

const svgNode = resolveMuiSvgNode(name, muiComponentName);

const sizeClasses: Record<IconSize, string> = {
  xs: 'h-3 w-3',
  sm: 'h-4 w-4',
  md: 'h-5 w-5',
  lg: 'h-6 w-6',
};

const hasCustomSize = /\b(h-|w-|size-)/.test(className);
const computedClass = [
  'shrink-0 select-none fill-current',
  hasCustomSize ? '' : sizeClasses[size],
  className,
]
  .filter(Boolean)
  .join(' ');
---

<svg
  id={id}
  class={computedClass}
  viewBox="0 0 24 24"
  fill="currentColor"
  data-mui-icon={muiComponentName}
  aria-label={ariaLabel}
  aria-hidden={ariaHidden}
  role={ariaLabel || title ? 'img' : undefined}
  focusable="false"
>
  {title && <title>{title}</title>}
  {svgNode.circles?.map((circle) => (
    <circle cx={circle.cx} cy={circle.cy} r={circle.r} />
  ))}
  {svgNode.paths.map((d) => (
    <path d={d} />
  ))}
</svg>
