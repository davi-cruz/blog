import fs from 'node:fs';
import { createRequire } from 'node:module';

const MUI_ICON_MAP = {
  sun: 'LightMode',
  moon: 'DarkMode',
  menu: 'Menu',
  close: 'Close',
  'chevron-down': 'ExpandMore',
  'chevron-left': 'ChevronLeft',
  'chevron-right': 'ChevronRight',
  check: 'Check',
  toc: 'Toc',
  info: 'Info',
  warning: 'Warning',
  error: 'Error',
  'check-circle': 'CheckCircle',
  'question-circle': 'Help',
  star: 'Star',
  share: 'Share',
  copy: 'ContentCopy',
  comments: 'Comment',
  'shield-check': 'GppGood',
  github: 'GitHub',
  linkedin: 'LinkedIn',
  twitter: 'X',
  whatsapp: 'WhatsApp',
  telegram: 'Telegram',
  rss: 'RssFeed',
  translate: 'Translate',
  mail: 'Email',
  'external-link': 'OpenInNew',
  'zoom-in': 'ZoomIn',
} as const;

type IconName = keyof typeof MUI_ICON_MAP;
type IconSize = 'xs' | 'sm' | 'md' | 'lg';

interface Props {
  name: IconName;
  size?: IconSize;
  class?: string;
  id?: string;
  title?: string;
  'aria-label'?: string;
  'aria-hidden'?: boolean | 'true' | 'false';
}

const {
  name,
  size = 'md',
  class: className = '',
  id,
  title,
  'aria-label': ariaLabel,
  'aria-hidden': ariaHidden = !ariaLabel && !title ? 'true' : undefined,
} = Astro.props;

interface SvgNode {
  paths: string[];
  circles?: { cx: string; cy: string; r: string }[];
