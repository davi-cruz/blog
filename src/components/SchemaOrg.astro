---
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  siteUrl: string;
  lang: Lang;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  image?: string;
  tags?: string[];
}

const {
  title,
  description,
  canonicalUrl,
  siteUrl,
  lang,
  article = false,
  pubDate,
  updatedDate,
  image = '/images/twitter-card.png',
  tags = [],
} = Astro.props;

const fullImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;
const isoLang = lang === 'pt-br' ? 'pt-BR' : lang;

// 1. Author Person Schema (E-E-A-T entity)
const authorSchema = {
  '@type': 'Person',
  '@id': `${siteUrl}/#author`,
  name: 'Davi Cruz',
  jobTitle: 'Senior Customer Engineer, Security',
  worksFor: {
    '@type': 'Organization',
    name: 'Google Cloud',
    url: 'https://cloud.google.com',
  },
  url: `${siteUrl}/sobre`,
  sameAs: [
    'https://www.linkedin.com/in/davicruz',
    'https://twitter.com/zerahzurc',
    'https://github.com/davi-cruz',
    'https://davicruz.com',
  ],
  knowsAbout: [
    'Cybersecurity',
    'Security Operations',
    'Threat Intelligence',
    'Penetration Testing',
    'Cloud Security',
    'Linux Administration',
  ],
};

// 2. Publisher Organization Schema
const publisherSchema = {
  '@type': 'Person',
  name: 'Davi Cruz',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/images/logo.svg`,
  },
};

// 3. WebSite Schema (For all pages)
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Davi Cruz',
  description: 'Technical blog covering cybersecurity, penetration testing, cloud security, and Linux administration.',
  inLanguage: ['pt-BR', 'en', 'es'],
  publisher: {
    '@id': `${siteUrl}/#author`,
  },
};

// 4. BreadcrumbList Schema
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: siteUrl,
  },
];

if (canonicalUrl.includes('/tags/')) {
  breadcrumbItems.push(
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Tags',
      item: `${siteUrl}/tags`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: canonicalUrl,
    }
  );
} else if (article) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    position: 2,
    name: title,
    item: canonicalUrl,
  });
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItems,
};

// 5. TechArticle / BlogPosting Schema (For articles)
let articleSchema: Record<string, any> | null = null;
if (article) {
  articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    '@id': `${canonicalUrl}#article`,
    isPartOf: {
      '@id': `${siteUrl}/#website`,
    },
    headline: title,
    description: description,
    image: [fullImageUrl],
    inLanguage: isoLang,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
    datePublished: pubDate ? pubDate.toISOString() : undefined,
    dateModified: (updatedDate || pubDate) ? (updatedDate || pubDate)!.toISOString() : undefined,
    author: authorSchema,
    publisher: publisherSchema,
    keywords: tags.length > 0 ? tags.join(', ') : undefined,
    dependencies: 'Security Operations, Threat Intelligence, Penetration Testing',
    proficiencyLevel: 'Beginner to Advanced',
  };
}

const schemas: Record<string, any>[] = [websiteSchema, breadcrumbSchema];
if (articleSchema) {
  schemas.push(articleSchema);
}
---

{schemas.map((schema) => (
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
