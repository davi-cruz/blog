---
import { getCollection } from 'astro:content';
import { languages, supportedLangs, type Lang } from '../i18n/ui';

interface Props {
  currentLang: Lang;
  translationId?: string;
  customAlternates?: { lang: string; url: string }[];
}

const { currentLang, translationId, customAlternates } = Astro.props;

// Prepare default URLs for all supported languages
const targetUrls: Record<Lang, string> = {
  'pt-br': '/',
  en: '/en/',
  es: '/es/',
};

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

if (customAlternates && customAlternates.length > 0) {
  for (const alt of customAlternates) {
    if (alt.lang in targetUrls) {
      const pathOnly = alt.url.replace(/^https?:\/\/[^\/]+/, '') || '/';
      targetUrls[alt.lang as Lang] = pathOnly;
    }
  }
} else if (translationId) {
  const allPosts = await getCollection('blog');
  for (const lang of supportedLangs) {
    const postMatch = allPosts.find((p) => {
      const pLang = p.slug.split('/')[0];
      return pLang === lang && p.data.translationId === translationId;
    });

    if (postMatch) {
      const postSlug = postMatch.slug.split('/').slice(1).join('/');
      if (lang === 'pt-br') {
        targetUrls[lang] = `/${postSlug}`;
      } else {
        targetUrls[lang] = `/${lang}/${postSlug}`;
      }
    }
  }
} else if (pathname === '/sobre' || pathname === '/en/about' || pathname === '/es/acerca-de') {
  targetUrls['pt-br'] = '/sobre';
  targetUrls.en = '/en/about';
  targetUrls.es = '/es/acerca-de';
} else if (pathname === '/projetos' || pathname === '/en/projects' || pathname === '/es/proyectos') {
  targetUrls['pt-br'] = '/projetos';
  targetUrls.en = '/en/projects';
  targetUrls.es = '/es/proyectos';
} else if (pathname.includes('/tags/')) {
  const tagPart = pathname.split('/tags/')[1] || '';
  targetUrls['pt-br'] = `/tags/${tagPart}`;
  targetUrls.en = `/en/tags/${tagPart}`;
  targetUrls.es = `/es/tags/${tagPart}`;
}
---

<div class="relative inline-block text-left" id="lang-switcher">
  <button
    type="button"
    id="lang-menu-button"
    class="flex items-center gap-1.5 rounded-lg border border-gray-300 px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-100 hover:text-gray-900 focus:outline-none dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
    aria-expanded="false"
    aria-haspopup="true"
    aria-label="Change language"
  >
    <span>{languages[currentLang]?.flag}</span>
    <span class="uppercase tracking-wider font-mono">{currentLang}</span>
    <svg class="h-3.5 w-3.5 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    id="lang-menu-dropdown"
    class="hidden absolute right-0 z-50 mt-2 w-36 origin-top-right rounded-lg bg-white p-1 shadow-lg ring-1 ring-black ring-opacity-5 focus:outline-none dark:bg-gray-900 dark:ring-gray-800"
    role="menu"
    aria-orientation="vertical"
    tabindex="-1"
  >
    {supportedLangs.map((lang) => {
      const isCurrent = lang === currentLang;
      return (
        <a
          href={targetUrls[lang]}
          class:list={[
            'flex items-center gap-2 rounded-md px-3 py-2 text-xs font-medium transition-colors',
            isCurrent
              ? 'bg-primary-50 text-primary-600 dark:bg-primary-950/60 dark:text-primary-400 font-semibold'
              : 'text-gray-700 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white',
          ]}
          role="menuitem"
        >
          <span>{languages[lang].flag}</span>
          <span>{languages[lang].name}</span>
          {isCurrent && (
            <svg class="ml-auto h-3.5 w-3.5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
            </svg>
          )}
        </a>
      );
    })}
  </div>
</div>

<script>
  function setupLangDropdown() {
    const button = document.getElementById('lang-menu-button');
    const dropdown = document.getElementById('lang-menu-dropdown');

    if (!button || !dropdown) return;

    button.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      dropdown.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target as Node) && !button.contains(e.target as Node)) {
        dropdown.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
      }
    });
  }

  setupLangDropdown();
  document.addEventListener('astro:after-swap', setupLangDropdown);
</script>
