---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';
import { getReadingTime } from '../utils/readingTime';
import Icon from './Icon.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);

const slugPart = post.slug.split('/').slice(1).join('/');
const postUrl = lang === 'pt-br' ? `/${slugPart}` : `/${lang}/${slugPart}`;

const readingMinutes = getReadingTime(post.body);

const formattedDate = new Intl.DateTimeFormat(
  lang === 'pt-br' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
).format(post.data.pubDate);

const hasHeroImage = Boolean(post.data.heroImage);
---

<div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-6 sm:p-8 shadow-sm transition hover:border-primary-500 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/60 dark:hover:border-primary-500">
  <div class={hasHeroImage ? "flex flex-col md:flex-row md:items-center md:gap-8" : ""}>
    {hasHeroImage && (
      <div class="mb-6 md:mb-0 md:w-5/12 shrink-0">
        <a href={postUrl} class="block overflow-hidden rounded-xl border border-gray-100 dark:border-gray-800 shadow-sm aspect-video w-full group/img focus:outline-none">
          <img
            src={post.data.heroImage}
            alt={post.data.title}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="eager"
            fetchpriority="high"
          />
        </a>
      </div>
    )}

    <div class={hasHeroImage ? "flex-1 min-w-0" : ""}>
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center gap-1 rounded-full bg-primary-500 px-3 py-1 text-xs font-bold text-white shadow-sm">
            <Icon name="star" size="xs" />
            {t('blog.featured')}
          </span>
          <span class="text-xs text-gray-500 dark:text-gray-400">
            • {readingMinutes} {t('blog.readTime')}
          </span>
        </div>

        <time datetime={post.data.pubDate.toISOString()} class="text-xs font-medium text-gray-500 dark:text-gray-400">
          {formattedDate}
        </time>
      </div>

      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-gray-900 group-hover:text-primary-500 dark:text-white dark:group-hover:text-primary-400 transition-colors">
        <a href={postUrl} class="focus:outline-none">
          {post.data.title}
        </a>
      </h2>

      {post.data.description && (
        <p class="mt-3 text-base text-gray-600 dark:text-gray-300 leading-relaxed line-clamp-3">
          {post.data.description}
        </p>
      )}

      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-gray-200/80 pt-4 dark:border-gray-800/80">
        <!-- Tags -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap">
            {post.data.tags.slice(0, 4).map((tag) => {
              const tagUrl = lang === 'pt-br' ? `/tags/${encodeURIComponent(tag.toLowerCase())}` : `/${lang}/tags/${encodeURIComponent(tag.toLowerCase())}`;
              return (
                <a
                  href={tagUrl}
                  class="mr-3 text-xs font-semibold uppercase tracking-wider text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                >
                  {tag}
                </a>
              );
            })}
          </div>
        )}

        <!-- Read more link -->
        <a
          href={postUrl}
          class="inline-flex items-center gap-1 text-sm font-semibold text-primary-500 hover:text-primary-600 dark:hover:text-primary-400 transition-colors ml-auto"
        >
          <span>{t('blog.readMore')}</span>
        </a>
      </div>
    </div>
  </div>
</div>

