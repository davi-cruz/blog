---
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);

const slugPart = post.slug.split('/').slice(1).join('/');
const postUrl = lang === 'pt-br' ? `/${slugPart}` : `/${lang}/${slugPart}`;

const readingMinutes = getReadingTime(post.body);

const formattedDate = new Intl.DateTimeFormat(
  lang === 'pt-br' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
).format(post.data.pubDate);
---

<div class="group relative overflow-hidden rounded-3xl border border-neutral-200/90 bg-gradient-to-br from-white via-pink-50/20 to-neutral-50/50 p-6 sm:p-8 shadow-sm transition hover:border-primary-500/50 hover:shadow-lg dark:border-neutral-800 dark:from-neutral-900/80 dark:via-pink-950/20 dark:to-neutral-900/40">
  <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1 rounded-full bg-gradient-to-r from-pink-500 to-rose-500 px-3 py-1 text-xs font-bold text-white shadow-sm">
        <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
        </svg>
        {t('blog.featured')}
      </span>
      <span class="text-xs text-neutral-500 dark:text-neutral-400">
        • {readingMinutes} {t('blog.readTime')}
      </span>
    </div>

    <time datetime={post.data.pubDate.toISOString()} class="text-xs font-medium text-neutral-500 dark:text-neutral-400">
      {formattedDate}
    </time>
  </div>

  <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-neutral-900 group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400 transition-colors">
    <a href={postUrl} class="focus:outline-none">
      {post.data.title}
    </a>
  </h2>

  {post.data.description && (
    <p class="mt-3 text-base text-neutral-600 dark:text-neutral-300 leading-relaxed line-clamp-3">
      {post.data.description}
    </p>
  )}

  <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-neutral-200/60 pt-4 dark:border-neutral-800/60">
    <!-- Tags -->
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {post.data.tags.slice(0, 4).map((tag) => {
          const tagUrl = lang === 'pt-br' ? `/tags/${encodeURIComponent(tag.toLowerCase())}` : `/${lang}/tags/${encodeURIComponent(tag.toLowerCase())}`;
          return (
            <a
              href={tagUrl}
              class="rounded-md bg-white/80 px-2.5 py-0.5 text-xs font-semibold text-neutral-600 border border-neutral-200/80 hover:border-primary-500 hover:text-primary-600 dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-primary-500 dark:hover:text-primary-400 transition"
            >
              #{tag}
            </a>
          );
        })}
      </div>
    )}

    <!-- Read more link -->
    <a
      href={postUrl}
      class="inline-flex items-center gap-1 text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400 dark:hover:text-primary-300 transition-colors ml-auto"
    >
      <span>{t('blog.readMore')}</span>
    </a>
  </div>
</div>

