---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getCollection } from 'astro:content';
import { defaultLang, supportedLangs, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  translationId?: string;
  image?: string;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  customAlternates?: { lang: string; url: string }[];
  noindex?: boolean;
}

const {
  title = 'Davi Cruz | Cybersecurity & Infrastructure',
  description = 'Technical blog covering cybersecurity, penetration testing, cloud security, and Linux administration.',
  lang = defaultLang,
  translationId,
  image = '/images/twitter-card.png',
  article = false,
  pubDate,
  updatedDate,
  tags = [],
  customAlternates,
  noindex = false,
} = Astro.props;

// Read site URL from env or fallback
const siteUrl = (import.meta.env.SITE_URL || Astro.site?.toString() || 'https://davicruz.com').replace(/\/+$/, '');
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '';
const canonicalUrl = `${siteUrl}${currentPath || '/'}`;

// Absolute image URL
const ogImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

// BCP 47 language mapping
const BCP47_MAP: Record<string, string> = {
  'pt-br': 'pt-BR',
  en: 'en',
  es: 'es',
  'x-default': 'x-default',
};

// Compute dynamic, accurate hreflang alternates (ONLY valid existing URLs)
interface HreflangEntry {
  lang: string;
  url: string;
}
let hreflangEntries: HreflangEntry[] = [];

if (customAlternates && customAlternates.length > 0) {
  hreflangEntries = customAlternates.map((alt) => ({
    lang: BCP47_MAP[alt.lang] || alt.lang,
    url: alt.url.replace(/\/+$/, '') || `${siteUrl}/`,
  }));
} else if (translationId) {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);
  const matchedPosts: { lang: Lang; url: string }[] = [];

  for (const l of supportedLangs) {
    const match = allPosts.find((p) => {
      const pLang = p.slug.split('/')[0];
      return pLang === l && p.data.translationId === translationId;
    });

    if (match) {
      const slugWithoutLang = match.slug.split('/').slice(1).join('/');
      const postUrl = l === 'pt-br' ? `${siteUrl}/${slugWithoutLang}` : `${siteUrl}/${l}/${slugWithoutLang}`;
      matchedPosts.push({ lang: l, url: postUrl });
    }
  }

  // Only emit alternates for languages that actually have this post!
  for (const m of matchedPosts) {
    hreflangEntries.push({
      lang: BCP47_MAP[m.lang] || m.lang,
      url: m.url,
    });
  }

  // x-default: prefer English version if available, otherwise Portuguese default
  const defaultTarget = matchedPosts.find((m) => m.lang === 'en') || matchedPosts.find((m) => m.lang === 'pt-br') || matchedPosts[0];
  if (defaultTarget) {
    hreflangEntries.push({
      lang: 'x-default',
      url: defaultTarget.url,
    });
  }
} else if (currentPath === '/sobre' || currentPath === '/en/about' || currentPath === '/es/acerca-de') {
  hreflangEntries = [
    { lang: 'pt-BR', url: `${siteUrl}/sobre` },
    { lang: 'en', url: `${siteUrl}/en/about` },
    { lang: 'es', url: `${siteUrl}/es/acerca-de` },
    { lang: 'x-default', url: `${siteUrl}/sobre` },
  ];
} else if (currentPath === '/projetos' || currentPath === '/en/projects' || currentPath === '/es/proyectos') {
  hreflangEntries = [
    { lang: 'pt-BR', url: `${siteUrl}/projetos` },
    { lang: 'en', url: `${siteUrl}/en/projects` },
    { lang: 'es', url: `${siteUrl}/es/proyectos` },
    { lang: 'x-default', url: `${siteUrl}/projetos` },
  ];
} else if (currentPath === '/privacidade' || currentPath === '/en/privacy' || currentPath === '/es/privacidad') {
  hreflangEntries = [
    { lang: 'pt-BR', url: `${siteUrl}/privacidade` },
    { lang: 'en', url: `${siteUrl}/en/privacy` },
    { lang: 'es', url: `${siteUrl}/es/privacidad` },
    { lang: 'x-default', url: `${siteUrl}/privacidade` },
  ];
} else if (currentPath === '' || currentPath === '/' || currentPath === '/en' || currentPath === '/es') {
  hreflangEntries = [
    { lang: 'pt-BR', url: `${siteUrl}/` },
    { lang: 'en', url: `${siteUrl}/en` },
    { lang: 'es', url: `${siteUrl}/es` },
    { lang: 'x-default', url: `${siteUrl}/` },
  ];
} else if (currentPath === '/tags' || currentPath === '/en/tags' || currentPath === '/es/tags') {
  hreflangEntries = [
    { lang: 'pt-BR', url: `${siteUrl}/tags` },
    { lang: 'en', url: `${siteUrl}/en/tags` },
    { lang: 'es', url: `${siteUrl}/es/tags` },
    { lang: 'x-default', url: `${siteUrl}/tags` },
  ];
} else if (currentPath.includes('/tags/')) {
  // Check if tag exists in each language before outputting hreflang
  const tagPart = decodeURIComponent(currentPath.split('/tags/')[1] || '').toLowerCase();
  const allPosts = await getCollection('blog', ({ data }) => !data.draft);

  for (const l of supportedLangs) {
    const hasTagInLang = allPosts.some(
      (p) => p.slug.startsWith(`${l}/`) && p.data.tags?.some((t) => t.toLowerCase() === tagPart)
    );
    if (hasTagInLang) {
      const tagUrl = l === 'pt-br' ? `${siteUrl}/tags/${encodeURIComponent(tagPart)}` : `${siteUrl}/${l}/tags/${encodeURIComponent(tagPart)}`;
      hreflangEntries.push({
        lang: BCP47_MAP[l] || l,
        url: tagUrl,
      });
    }
  }

  const ptEntry = hreflangEntries.find((e) => e.lang === 'pt-BR');
  if (ptEntry) {
    hreflangEntries.push({ lang: 'x-default', url: ptEntry.url });
  } else if (hreflangEntries.length > 0) {
    hreflangEntries.push({ lang: 'x-default', url: hreflangEntries[0].url });
  }
}

const ogLocaleMap: Record<Lang, string> = {
  'pt-br': 'pt_BR',
  en: 'en_US',
  es: 'es_ES',
};
const ogLocale = ogLocaleMap[lang] || 'pt_BR';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="Davi Cruz Blog RSS Feed" href="/rss.xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Tag Manager & Consent Mode v2 -->
    <GoogleTagManager part="head" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Davi Cruz" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:creator" content="@zerahzurc" />

    <!-- Hreflang Tags for Multi-language SEO -->
    {hreflangEntries.map((entry) => (
      <link rel="alternate" hreflang={entry.lang} href={entry.url} />
    ))}

    <!-- Schema.org JSON-LD Structured Data -->
    <SchemaOrg
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      siteUrl={siteUrl}
      lang={lang}
      article={article}
      pubDate={pubDate}
      updatedDate={updatedDate}
      image={ogImageUrl}
      tags={tags}
    />

    <!-- Dark Mode Initializer to Prevent Flash of Unstyled Content (FOUC) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-white text-gray-900 selection:bg-primary-500 selection:text-white dark:bg-gray-950 dark:text-gray-100 flex flex-col antialiased">
    <!-- Google Tag Manager (noscript) -->
    <GoogleTagManager part="body" />

    <Header currentLang={lang} translationId={translationId} customAlternates={customAlternates} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
    <CookieConsent lang={lang} />
  </body>
</html>
