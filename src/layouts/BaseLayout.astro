---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { defaultLang, supportedLangs, type Lang } from '../i18n/ui';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  translationId?: string;
  image?: string;
  article?: boolean;
  customAlternates?: { lang: string; url: string }[];
}

const {
  title = 'Davi Cruz | Cybersecurity & Infrastructure',
  description = 'Technical blog covering cybersecurity, penetration testing, cloud security, and Linux administration.',
  lang = defaultLang,
  translationId,
  image = '/images/twitter-card.png',
  article = false,
  customAlternates,
} = Astro.props;

// Read site URL from env or fallback
const siteUrl = (import.meta.env.SITE_URL || Astro.site?.toString() || 'https://davicruz.com').replace(/\/+$/, '');
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '';
const canonicalUrl = `${siteUrl}${currentPath || '/'}`;

// Absolute image URL
const ogImageUrl = image.startsWith('http') ? image : `${siteUrl}${image.startsWith('/') ? '' : '/'}${image}`;

// Compute hreflang alternates
const hreflangLinks: Record<Lang | 'x-default', string> = {
  'pt-br': `${siteUrl}/`,
  en: `${siteUrl}/en/`,
  es: `${siteUrl}/es/`,
  'x-default': `${siteUrl}/`,
};

if (customAlternates && customAlternates.length > 0) {
  for (const alt of customAlternates) {
    hreflangLinks[alt.lang as Lang | 'x-default'] = alt.url;
  }
} else if (translationId) {
  const allPosts = await getCollection('blog');
  for (const l of supportedLangs) {
    const match = allPosts.find((p) => {
      const pLang = p.slug.split('/')[0];
      return pLang === l && p.data.translationId === translationId;
    });

    if (match) {
      const slugWithoutLang = match.slug.split('/').slice(1).join('/');
      if (l === 'pt-br') {
        hreflangLinks[l] = `${siteUrl}/${slugWithoutLang}`;
      } else {
        hreflangLinks[l] = `${siteUrl}/${l}/${slugWithoutLang}`;
      }
    }
  }
  hreflangLinks['x-default'] = hreflangLinks['pt-br'];
} else if (currentPath === '/sobre' || currentPath === '/en/about' || currentPath === '/es/acerca-de') {
  hreflangLinks['pt-br'] = `${siteUrl}/sobre`;
  hreflangLinks['en'] = `${siteUrl}/en/about`;
  hreflangLinks['es'] = `${siteUrl}/es/acerca-de`;
  hreflangLinks['x-default'] = `${siteUrl}/sobre`;
} else if (currentPath === '/projetos' || currentPath === '/en/projects' || currentPath === '/es/proyectos') {
  hreflangLinks['pt-br'] = `${siteUrl}/projetos`;
  hreflangLinks['en'] = `${siteUrl}/en/projects`;
  hreflangLinks['es'] = `${siteUrl}/es/proyectos`;
  hreflangLinks['x-default'] = `${siteUrl}/projetos`;
} else if (currentPath.includes('/tags/')) {
  // Localized tag page hreflangs
  const tagPart = currentPath.split('/tags/')[1] || '';
  hreflangLinks['pt-br'] = `${siteUrl}/tags/${tagPart}`;
  hreflangLinks['en'] = `${siteUrl}/en/tags/${tagPart}`;
  hreflangLinks['es'] = `${siteUrl}/es/tags/${tagPart}`;
  hreflangLinks['x-default'] = `${siteUrl}/tags/${tagPart}`;
}

const ogLocaleMap: Record<Lang, string> = {
  'pt-br': 'pt_BR',
  en: 'en_US',
  es: 'es_ES',
};
const ogLocale = ogLocaleMap[lang] || 'pt_BR';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="alternate" type="application/rss+xml" title="Davi Cruz Blog RSS Feed" href="/rss.xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="Davi Cruz" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:creator" content="@zerahzurc" />

    <!-- Hreflang Tags for Multi-language SEO -->
    <link rel="alternate" hreflang="pt-br" href={hreflangLinks['pt-br']} />
    <link rel="alternate" hreflang="en" href={hreflangLinks['en']} />
    <link rel="alternate" hreflang="es" href={hreflangLinks['es']} />
    <link rel="alternate" hreflang="x-default" href={hreflangLinks['x-default']} />

    <!-- Dark Mode Initializer to Prevent Flash of Unstyled Content (FOUC) -->
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-white text-gray-900 selection:bg-primary-500 selection:text-white dark:bg-gray-950 dark:text-gray-100 flex flex-col antialiased">
    <Header currentLang={lang} translationId={translationId} customAlternates={customAlternates} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
