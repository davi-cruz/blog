---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SocialShare from '../components/SocialShare.astro';
import Comments from '../components/Comments.astro';
import Alert from '../components/Alert.astro';
import { getEntry, type CollectionEntry } from 'astro:content';
import { languages, useTranslations, type Lang } from '../i18n/ui';
import { getReadingTime } from '../utils/readingTime';
import type { FallbackInfo } from '../utils/postFallback';

interface Props {
  post: CollectionEntry<'blog'>;
  lang: Lang;
  headings: { depth: number; slug: string; text: string }[];
  prevPost?: CollectionEntry<'blog'> | null;
  nextPost?: CollectionEntry<'blog'> | null;
  fallbackInfo?: FallbackInfo | null;
}

const { post, lang, headings, prevPost, nextPost, fallbackInfo = null } = Astro.props;
const { Content } = await post.render();
const author = (await getEntry('authors', `${lang}/default`)) || (await getEntry('authors', 'en/default'));
const t = useTranslations(lang);

const siteUrl = (import.meta.env.SITE_URL || Astro.site?.toString() || 'https://davicruz.com').replace(/\/+$/, '');
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '';
const articleUrl = `${siteUrl}${currentPath}`;

const customAlternates = fallbackInfo?.availableVersions?.map((v) => ({
  lang: v.lang,
  url: `${siteUrl}${v.url}`,
}));

const readingMinutes = getReadingTime(post.body);

const formattedDate = new Intl.DateTimeFormat(
  lang === 'pt-br' ? 'pt-BR' : lang === 'es' ? 'es-ES' : 'en-US',
  {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }
).format(post.data.pubDate);

const backUrl = lang === 'pt-br' ? '/' : `/${lang}/`;

function getPostUrl(p: CollectionEntry<'blog'>) {
  const slugPart = p.slug.split('/').slice(1).join('/');
  return lang === 'pt-br' ? `/${slugPart}` : `/${lang}/${slugPart}`;
}
---

<BaseLayout
  title={`${post.data.title} | Davi Cruz`}
  description={post.data.description}
  lang={lang}
  translationId={post.data.translationId}
  image={post.data.heroImage}
  article={true}
  customAlternates={customAlternates}
  noindex={!!fallbackInfo}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10">
    <!-- Back to blog link -->
    <a
      href={backUrl}
      class="inline-flex items-center gap-1 text-sm font-medium text-gray-500 hover:text-primary-500 transition-colors mb-8"
    >
      {t('blog.backToBlog')}
    </a>

    <!-- Article Header -->
    <header class="mb-10">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400 mb-3">
        <time datetime={post.data.pubDate.toISOString()}>
          {formattedDate}
        </time>
        <span>•</span>
        <span>{readingMinutes} {t('blog.readTime')}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 leading-tight">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
          {post.data.description}
        </p>
      )}

      <!-- Tags & Author Row -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-b border-gray-200 pb-6 dark:border-gray-800">
        <!-- Author Profile -->
        <a href={lang === 'pt-br' ? '/sobre' : lang === 'es' ? '/es/acerca-de' : '/en/about'} class="group flex items-center gap-3">
          <img
            src="/images/avatar.png"
            alt="Davi Cruz"
            class="h-11 w-11 rounded-full object-cover ring-2 ring-primary-500/20 group-hover:ring-primary-500 transition"
          />
          <div>
            <p class="text-sm font-semibold text-gray-900 group-hover:text-primary-500 dark:text-white dark:group-hover:text-primary-400 transition-colors">
              Davi Cruz
            </p>
            <p class="text-xs text-gray-500 dark:text-gray-400">
              {author ? `${author.data.occupation} @ ${author.data.company}` : 'Security Specialist'}
            </p>
          </div>
        </a>

        <!-- Tags -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="flex flex-wrap">
            {post.data.tags.map((tag) => {
              const tagUrl = lang === 'pt-br' ? `/tags/${encodeURIComponent(tag.toLowerCase())}` : `/${lang}/tags/${encodeURIComponent(tag.toLowerCase())}`;
              return (
                <a
                  href={tagUrl}
                  class="mr-3 text-sm font-medium uppercase text-primary-500 hover:text-primary-600 dark:hover:text-primary-400"
                >
                  {tag}
                </a>
              );
            })}
          </div>
        )}
      </div>
    </header>

    {post.data.heroImage && (
      <div class="mb-10 overflow-hidden rounded-2xl border border-gray-200 dark:border-gray-800 shadow-sm aspect-video md:aspect-[2/1]">
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          class="h-full w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}

    {fallbackInfo && (
      <aside class="mb-10 rounded-2xl border border-blue-200 bg-blue-50/70 p-5 shadow-sm dark:border-blue-900/60 dark:bg-blue-950/30 not-prose" aria-label="Aviso de idioma">
        <div class="flex items-start gap-4">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-100 text-blue-600 dark:bg-blue-900/60 dark:text-blue-300">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <h2 class="text-base font-semibold text-blue-900 dark:text-blue-100">
              {t('fallback.noticeTitle')}
            </h2>
            <p class="mt-1 text-sm text-blue-700 dark:text-blue-300">
              {t('fallback.noticeSubtitle')}
            </p>
            <div class="mt-3.5 flex flex-wrap gap-2.5">
              {fallbackInfo.availableVersions.map((v) => (
                <a
                  href={v.url}
                  class="inline-flex items-center gap-1.5 rounded-lg border border-blue-200 bg-white px-3.5 py-1.5 text-xs font-semibold text-blue-700 shadow-sm transition hover:bg-blue-50 dark:border-blue-800 dark:bg-gray-900 dark:text-blue-300 dark:hover:bg-blue-950"
                >
                  <span>{languages[v.lang]?.flag}</span>
                  <span>{languages[v.lang]?.name}:</span>
                  <span class="underline underline-offset-2">{v.title}</span>
                  <span>→</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </aside>
    )}

    <!-- Main Content Area with Sticky TOC -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_260px] gap-10 items-start">
      <article class="min-w-0 prose max-w-none dark:prose-invert prose-headings:scroll-mt-24 prose-img:rounded-xl prose-img:shadow-md prose-headings:font-bold prose-pre:my-6">
        <!-- Mobile TOC Accordion -->
        <TableOfContents headings={headings} lang={lang} />

        <!-- Render MDX with global Alert component -->
        <Content components={{ Alert }} />

        <!-- Social Share Bar -->
        <SocialShare title={post.data.title} url={articleUrl} lang={lang} />

        <!-- Prev / Next Post Navigation -->
        {(prevPost || nextPost) && (
          <nav class="my-10 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-b border-gray-200 py-6 dark:border-gray-800 not-prose">
            {prevPost ? (
              <a
                href={getPostUrl(prevPost)}
                class="group flex flex-col rounded-xl border border-gray-200 p-4 transition hover:border-primary-500 hover:shadow-sm dark:border-gray-800 dark:hover:border-primary-500"
              >
                <span class="text-xs font-medium text-gray-400 dark:text-gray-500">
                  {t('blog.prevPost')}
                </span>
                <span class="mt-1 font-semibold text-gray-800 group-hover:text-primary-600 dark:text-gray-200 dark:group-hover:text-primary-400 line-clamp-1 transition-colors">
                  {prevPost.data.title}
                </span>
              </a>
            ) : <div />}

            {nextPost && (
              <a
                href={getPostUrl(nextPost)}
                class="group flex flex-col text-right rounded-xl border border-gray-200 p-4 transition hover:border-primary-500 hover:shadow-sm dark:border-gray-800 dark:hover:border-primary-500"
              >
                <span class="text-xs font-medium text-gray-400 dark:text-gray-500">
                  {t('blog.nextPost')}
                </span>
                <span class="mt-1 font-semibold text-gray-800 group-hover:text-primary-600 dark:text-gray-200 dark:group-hover:text-primary-400 line-clamp-1 transition-colors">
                  {nextPost.data.title}
                </span>
              </a>
            )}
          </nav>
        )}

        <!-- Utteranc.es Comments Section -->
        <Comments translationId={post.data.translationId} lang={lang} />
      </article>

      <!-- Desktop Sticky TOC Sidebar -->
      <aside class="hidden lg:block">
        <TableOfContents headings={headings} lang={lang} />
      </aside>
    </div>
  </div>
</BaseLayout>
