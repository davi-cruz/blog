---
import BaseLayout from './BaseLayout.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { projectsData } from '../data/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = projectsData[lang] || [];

const alternates = [
  { lang: 'pt-br', url: 'https://davicruz.com/projetos' },
  { lang: 'en', url: 'https://davicruz.com/en/projects' },
  { lang: 'es', url: 'https://davicruz.com/es/proyectos' },
  { lang: 'x-default', url: 'https://davicruz.com/projetos' },
];
---

<BaseLayout
  title={`${t('projects.title')} | Davi Cruz`}
  description={t('projects.description')}
  lang={lang}
  customAlternates={alternates}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="divide-y divide-gray-200 dark:divide-gray-700">
      <header class="pb-8 space-y-2 md:space-y-4">
        <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl md:text-5xl">
          {t('projects.title')}
        </h1>
        <p class="text-base text-gray-500 dark:text-gray-400 max-w-2xl">
          {t('projects.description')}
        </p>
      </header>

      <div class="py-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {projects.map((project) => (
            <div class="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-1 hover:border-primary-500 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/60 dark:hover:border-primary-500">
              {project.imgSrc && (
                <a href={project.href} target="_blank" rel="noopener noreferrer" class="relative block overflow-hidden bg-gray-100 dark:bg-gray-800 aspect-video">
                  <img
                    src={project.imgSrc}
                    alt={project.title}
                    class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                </a>
              )}

              <div class="flex flex-1 flex-col justify-between p-6">
                <div>
                  {project.tags && project.tags.length > 0 && (
                    <div class="mb-3 flex flex-wrap gap-1.5">
                      {project.tags.map((tag) => (
                        <span class="rounded-md bg-primary-50 px-2 py-0.5 text-xs font-semibold text-primary-600 dark:bg-primary-950/60 dark:text-primary-300">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}

                  <h2 class="text-xl font-bold tracking-tight text-gray-900 group-hover:text-primary-500 dark:text-gray-100 dark:group-hover:text-primary-400 transition-colors">
                    <a href={project.href} target="_blank" rel="noopener noreferrer">
                      {project.title}
                    </a>
                  </h2>

                  <p class="mt-3 text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                    {project.description}
                  </p>
                </div>

                <div class="mt-6 pt-4 border-t border-gray-100 dark:border-gray-800/60">
                  <a
                    href={project.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-500 hover:text-primary-600 dark:text-primary-400 dark:hover:text-primary-300 transition-colors"
                  >
                    <span>{t('projects.learnMore')}</span>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

