            </table>
          </div>

          <h2>5. Sus Derechos</h2>
          <p>Puede revocar su consentimiento en cualquier momento utilizando el botón superior o el enlace en el pie de página.</p>

          <h2>6. Contacto</h2>
          <p>
            <strong>Correo electrónico:</strong> <a href="mailto:eu@davicruz.com">eu@davicruz.com</a><br />
            <strong>Responsable:</strong> Davi Cruz
          </p>
        </>
      )}
    </article>
  </div>
</BaseLayout>

<script is:inline define:vars={{ statusGranted: t.statusGranted, statusDenied: t.statusDenied, statusUnset: t.statusUnset }}>
  function updateConsentDisplay() {
    var statusEl = document.getElementById('privacy-consent-status');
    if (!statusEl) return;

    var val = null;
    try {
      val = localStorage.getItem('davi_privacy_consent');
    } catch (e) {}

    if (val === 'granted') {
      statusEl.textContent = statusGranted;
      statusEl.className = 'font-bold text-emerald-600 dark:text-emerald-400';
    } else if (val === 'denied') {
      statusEl.textContent = statusDenied;
      statusEl.className = 'font-bold text-amber-600 dark:text-amber-400';
    } else {
      statusEl.textContent = statusUnset;
      statusEl.className = 'font-bold text-gray-500 dark:text-gray-400';
    }
  }

  document.addEventListener('DOMContentLoaded', updateConsentDisplay);
  updateConsentDisplay();

  document.getElementById('privacy-open-banner-btn')?.addEventListener('click', function () {
    window.dispatchEvent(new CustomEvent('open-cookie-banner'));
  });

  window.addEventListener('storage', function (e) {
    if (e.key === 'davi_privacy_consent') {
      updateConsentDisplay();
    }
  });
</script>

