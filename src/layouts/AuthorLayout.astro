---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  author: CollectionEntry<'authors'>;
  lang: Lang;
}

const { author, lang } = Astro.props;
const { Content } = await author.render();
const t = useTranslations(lang);

// Alternates for the About page
const alternates = [
  { lang: 'pt-br', url: 'https://davicruz.com/sobre' },
  { lang: 'en', url: 'https://davicruz.com/en/about' },
  { lang: 'es', url: 'https://davicruz.com/es/acerca-de' },
  { lang: 'x-default', url: 'https://davicruz.com/sobre' },
];
---

<BaseLayout
  title={`${author.data.name} - ${t('about.title')} | Davi Cruz`}
  description={t('about.description')}
  lang={lang}
  customAlternates={alternates}
>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-12">
    <div class="divide-y divide-gray-200 dark:divide-gray-700">
      <header class="pb-8 space-y-2 md:space-y-4">
        <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl md:text-5xl">
          {t('about.title')}
        </h1>
        <p class="text-base text-gray-500 dark:text-gray-400">
          {t('about.description')}
        </p>
      </header>

      <div class="items-start space-y-10 pt-10 xl:grid xl:grid-cols-3 xl:gap-x-10 xl:space-y-0">
        <!-- Author Profile Sidebar -->
        <aside class="flex flex-col items-center text-center p-6 rounded-2xl bg-gray-50 dark:bg-gray-900/60 border border-gray-200/80 dark:border-gray-800">
          <div class="relative mb-5">
            <img
              src={author.data.avatar || '/images/avatar.png'}
              alt={author.data.name}
              class="h-44 w-44 rounded-full object-cover shadow-md ring-4 ring-gray-100 dark:ring-gray-800"
            />
          </div>

          <h2 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
            {author.data.name}
          </h2>

          {author.data.occupation && (
            <p class="mt-1 text-sm font-medium text-gray-600 dark:text-gray-300">
              {author.data.occupation}
            </p>
          )}

          {author.data.company && (
            <p class="text-xs text-primary-600 dark:text-primary-400 font-semibold mt-0.5">
              @ {author.data.company}
            </p>
          )}

          <!-- Social Links -->
          <div class="mt-6 flex items-center gap-3">
            {author.data.github && (
              <a
                href={author.data.github}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg p-2 text-gray-500 hover:bg-gray-200 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white transition"
                aria-label="GitHub"
              >
                <Icon name="github" size="md" />
              </a>
            )}

            {author.data.linkedin && (
              <a
                href={author.data.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg p-2 text-gray-500 hover:bg-gray-200 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white transition"
                aria-label="LinkedIn"
              >
                <Icon name="linkedin" size="md" />
              </a>
            )}

            {author.data.twitter && (
              <a
                href={author.data.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-lg p-2 text-gray-500 hover:bg-gray-200 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white transition"
                aria-label="Twitter / X"
              >
                <Icon name="twitter" size="md" />
              </a>
            )}

            {author.data.email && (
              <a
                href={`mailto:${author.data.email}`}
                class="rounded-lg p-2 text-gray-500 hover:bg-gray-200 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white transition"
                aria-label="Email"
              >
                <Icon name="mail" size="md" />
              </a>
            )}
          </div>
        </aside>

        <!-- Biography & Details Column -->
        <main class="min-w-0 prose max-w-none dark:prose-invert xl:col-span-2">
          <Content />
        </main>
      </div>
    </div>
  </div>
</BaseLayout>

